---
import Blog from '../layouts/Blog.astro';
import Taxonomy from '../components/Taxonomy.astro';
import { groups } from '../lib/content.js';
const tags = groups('tags');
---
<Blog title="Tags" url="/tag/"><div class="page clearfix"><div class="left"><h1>Tags</h1>{tags.map(group=><section><h2 id={group.name}>{group.name}</h2><ul>{group.posts.map(post=><li><time>{post.date}</time> <a href={post.url}>{post.title}</a> <Taxonomy post={post}/></li>)}</ul></section>)}</div></div></Blog>
