---
import Blog from '../layouts/Blog.astro';
import { posts } from '../lib/content.js';
---
<Blog title="Blog archive" url="/index_old.html"><div class="page clearfix"><div class="left"><h1>Welcome to DW Shao's Blog</h1><p>Random Thoughts on Software and Technologies</p><ul>{posts.map(post=><li><h2><a href={post.url}>{post.title}</a></h2><time>{post.date}</time></li>)}</ul></div></div></Blog>
